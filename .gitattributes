# Pretrained model weights are large binaries — store via Git LFS so the
# repo's regular git history stays small and `git clone` fetches them
# lazily. RetinaFace-R50.pth alone (104 MB) exceeds GitHub's 100 MB
# per-file hard limit without LFS.
weights/*.pth filter=lfs diff=lfs merge=lfs -text
weights/*.pt filter=lfs diff=lfs merge=lfs -text
weights/*.onnx filter=lfs diff=lfs merge=lfs -text
weights/*.task filter=lfs diff=lfs merge=lfs -text
